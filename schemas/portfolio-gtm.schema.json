{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pickbitsai/company-os/schemas/portfolio-gtm.schema.json",
  "title": "Company OS portfolio GTM",
  "description": "An evidence-led operating call for products tracked by the optional Company OS GTM panel.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "portfolioCall", "products"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "\\.portfolio-gtm/v1$"
    },
    "portfolio": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "portfolioCall": {
      "type": "string",
      "minLength": 1
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "lane",
          "audience",
          "hook",
          "route",
          "advanceWhen",
          "confidence",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "projectId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "lane": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "hook": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "advanceWhen": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": ["high", "medium", "low", "hypothesis"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
